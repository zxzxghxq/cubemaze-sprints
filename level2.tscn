[sub_resource type="Shader" id="Shader_urnph"]
code = "shader_type spatial;
render_mode blend_mix, cull_disabled;
void fragment(){
 float r1 = sin(UV.x * 34.0 + TIME * 1.4) * 0.025;
 float r2 = sin(UV.y * 25.0 - TIME * 1.1) * 0.02;
 ALBEDO = vec3(0.08, 0.42, 0.39) + r1 + r2;
 ROUGHNESS = 0.16;
 METALLIC = 0.08;
 ALPHA = 0.80;
}
"

