[sub_resource type="Shader" id="Shader_xft3c"]
code = "shader_type spatial;
render_mode blend_mix, unshaded, cull_disabled;
uniform vec4 water_tint : source_color;
uniform float flow_speed = 1.0;
uniform float phase = 0.0;
void vertex(){
 VERTEX.z += sin(UV.x * 20.0 + TIME * flow_speed + phase) * 0.035;
}
void fragment(){
 float fine_streak = sin(UV.x * 58.0 + TIME * 1.2 + phase) * 0.08;
 float falling = sin(UV.y * 42.0 - TIME * 7.0 * flow_speed + phase) * 0.10;
 float edge = smoothstep(0.0, 0.08, UV.x) * smoothstep(0.0, 0.08, 1.0 - UV.x);
 float foam = smoothstep(0.78, 1.0, UV.y) * 0.16 + smoothstep(0.88, 1.0, 1.0 - UV.y) * 0.22;
 ALBEDO = water_tint.rgb + fine_streak + falling + foam;
 ALPHA = clamp((water_tint.a + fine_streak * 0.35 + foam) * edge, 0.0, 0.92);
}
"

