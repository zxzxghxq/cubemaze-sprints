[sub_resource type="Shader" id="Shader_8eq31"]
code = "shader_type spatial;
render_mode blend_mix, unshaded, cull_disabled;
void fragment(){
 float cells = sin(UV.x * 45.0 + TIME * 2.1) * sin(UV.y * 32.0 - TIME * 1.6);
 float edge = smoothstep(0.0, 0.18, UV.x) * smoothstep(0.0, 0.18, 1.0 - UV.x);
 ALBEDO = mix(vec3(0.45, 0.78, 0.70), vec3(0.88, 1.0, 0.94), cells * 0.5 + 0.5);
 ALPHA = (0.38 + cells * 0.16) * edge;
}
"

